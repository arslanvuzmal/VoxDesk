{
  "name": "voxdesk-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable AI voice receptionist platform with appointment booking, lead qualification, human escalation, call intelligence and provider-ready telephony integrations.",
  "author": "Arslan Vuzmal Lone <arslanvuzmallone@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:studio": "prisma studio",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:call": "tsx scripts/demo-call.ts",
    "demo:story": "tsx scripts/demo-story.ts",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "elevenlabs:provision": "tsx scripts/provision-elevenlabs-agents.ts",
    "elevenlabs:verify": "tsx scripts/provision-elevenlabs-agents.ts verify",
    "portfolio:capture": "tsx scripts/portfolio-capture.ts",
    "audit:routes": "tsx scripts/audit-routes.ts",
    "docs:check": "tsx scripts/check-doc-links.ts",
    "verify": "npm run format:check && npm run docs:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:security && npx prisma validate && npm run audit:routes && npm run build && npm run test:e2e",
    "telnyx:provision": "tsx scripts/telnyx/provision.ts",
    "telnyx:verify": "tsx scripts/telnyx/verify.ts",
    "telnyx:test:inbound": "tsx scripts/telnyx/test-inbound.ts",
    "telnyx:test:outbound": "tsx scripts/telnyx/test-outbound.ts",
    "telnyx:test:concurrent": "tsx scripts/telnyx/test-concurrent.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.17.0",
    "@elevenlabs/elevenlabs-js": "^2.60.0",
    "@elevenlabs/react": "^1.12.0",
    "@openrouter/sdk": "^1.2.4",
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.34.4",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "date-fns": "^4.1.0",
    "geist": "^1.7.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.10.0",
    "lucide-react": "^0.475.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "telnyx": "^7.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
