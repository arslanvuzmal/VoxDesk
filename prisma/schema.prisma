// VoxDesk AI Prisma Database Schema
// Owner: Arslan Vuzmal Lone
// Database: PostgreSQL (Supabase Compatible)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SystemRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

enum WorkspacePlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  TRANSFERRED
}

enum CallOutcome {
  APPOINTMENT_SCHEDULED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  LEAD_QUALIFIED
  LEAD_REJECTED
  QUESTION_ANSWERED
  ESCALATED_HUMAN
  CALLBACK_REQUESTED
  CALLER_DISCONNECTED
  UNRESOLVED
}

enum CallChannel {
  WEB
  PHONE
  SIP
}

enum CallTerminationReason {
  CALLER_HANGUP
  RECIPIENT_HANGUP
  AGENT_HANGUP
  HUMAN_HANGUP
  NO_ANSWER
  BUSY
  VOICEMAIL
  FAILED_PROVIDER
  FAILED_AGENT
  FAILED_TOOL
  TIME_LIMIT
  COMPLIANCE_BLOCK
  ADMIN_CANCELLED
}

enum RecordingConsentState {
  NOT_REQUESTED
  DISCLOSURE_REQUIRED
  CONSENT_REQUESTED
  CONSENT_GRANTED
  CONSENT_DECLINED
  RECORDING_DISABLED
}

enum ConversationChannel {
  WEB_VOICE
  PHONE
  WEB_TEXT
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
  INTERACTIVE
}

enum ConversationStatus {
  CREATED
  ACTIVE
  HUMAN_HANDOFF
  FINALIZING
  COMPLETED
  FAILED
}

enum ConversationSpeaker {
  CUSTOMER
  AGENT
  HUMAN
  SYSTEM
}

enum ConversationMessageType {
  TEXT
  TRANSCRIPT
  TOOL
  EVENT
}

enum ConversationToolStatus {
  REQUESTED
  AUTHORIZED
  EXECUTING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum ConversationCompletenessStatus {
  COMPLETE
  PARTIAL
  NEEDS_REVIEW
  PROVIDER_DATA_MISSING
}

enum CampaignState {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignRecipientState {
  PENDING
  SUPPRESSED
  QUEUED
  DIALING
  RINGING
  ANSWERED
  COMPLETED
  NO_ANSWER
  BUSY
  VOICEMAIL
  FAILED
  OPTED_OUT
  FOLLOW_UP_REQUIRED
}

enum OutboundWorkflowType {
  APPOINTMENT_REMINDER
  REQUESTED_CALLBACK
  CUSTOMER_FOLLOW_UP
  MISSING_INFORMATION_REMINDER
  SERVICE_UPDATE
  CONSENTED_LEAD_FOLLOW_UP
  SURVEY_REQUEST
}

enum ConsentCategory {
  EXPRESS_CONSENT
  IMPLIED_CONSENT
  EXISTING_BUSINESS_RELATIONSHIP
  LEGAL_OBLIGATION
  VITAL_INTEREST
  PUBLIC_TASK
}

enum LanguageStatus {
  NOT_CONFIGURED
  CONTENT_INCOMPLETE
  PROVIDER_SUPPORTED
  TESTING
  VERIFIED
  DEGRADED
  DISABLED
}

enum ImprovementObservationCategory {
  UNANSWERED_BUSINESS_QUESTION
  INCORRECT_BUSINESS_INFORMATION
  REPEATED_QUESTION
  MISSED_REQUIRED_FIELD
  TOOL_FAILURE
  WRONG_ACTION
  FAILED_CONFIRMATION
  POOR_HANDOFF
  LANGUAGE_ERROR
  PRONUNCIATION_ERROR
  CALLER_INTERRUPTION_FAILURE
  LONG_RESPONSE
  UNSAFE_RESPONSE
  OUTBOUND_DISCLOSURE_FAILURE
  OPT_OUT_FAILURE
  PROVIDER_FAILURE
}

enum ImprovementProposalType {
  KNOWLEDGE_UPDATE
  PROMPT_ADJUSTMENT
  CONVERSATION_RULE
  TOOL_SCHEMA_CHANGE
  TOOL_RETRY_POLICY
  ESCALATION_RULE
  LANGUAGE_CONTENT_UPDATE
  PRONUNCIATION_UPDATE
  EVALUATION_CASE
  UI_WORKFLOW_CHANGE
}

enum ImprovementProposalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EVALUATION_RUNNING
  EVALUATION_PASSED
  EVALUATION_FAILED
  CANARY_DEPLOYED
  PROMOTED
  ROLLED_BACK
}

enum EvaluationType {
  DETERMINISTIC
  MODEL_BASED
}

enum DeploymentState {
  CANDIDATE
  SHADOW
  CANARY
  PRODUCTION
  ROLLED_BACK
}

enum LeadCategory {
  HOT
  WARM
  REVIEW
  COLD
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum OpportunityStage {
  QUALIFIED
  DISCOVERY
  PROPOSAL
  WON
  LOST
}

enum ProviderType {
  DEMO
  TWILIO
  VAPI
  RETELL
  LIVEKIT
  DEEPGRAM
  ELEVENLABS
  OPENAI
  ANTHROPIC
  GEMINI
  OPENROUTER
  GOOGLE_CALENDAR
  CALCOM
  HUBSPOT
  GENERIC_WEBHOOK
  TELNYX
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  status       String            @default("ACTIVE")
  systemRole   SystemRole        @default(USER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     Session[]
  memberships  WorkspaceMember[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id                       String                    @id @default(cuid())
  name                     String
  slug                     String                    @unique
  industry                 String                    @default("general")
  timezone                 String                    @default("America/New_York")
  plan                     WorkspacePlan             @default(FREE)
  status                   String                    @default("ACTIVE")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  members                  WorkspaceMember[]
  invitations              Invitation[]
  businessProfile          BusinessProfile?
  agents                   VoiceAgent[]
  phoneNumbers             PhoneNumber[]
  providerConnections      ProviderConnection[]
  knowledgeItems           KnowledgeItem[]
  qualificationRules       QualificationRule[]
  escalationPolicies       EscalationPolicy[]
  calls                    Call[]
  leads                    Lead[]
  calendarConnections      CalendarConnection[]
  appointments             Appointment[]
  opportunities            Opportunity[]
  crmConnections           CRMConnection[]
  crmActivities            CRMActivity[]
  notifications            Notification[]
  webhookEndpoints         WebhookEndpoint[]
  auditLogs                AuditLog[]
  languageProfiles         LanguageProfile[]
  sipTrunks                SipTrunk[]
  telephonyConnections     TelephonyConnection[]
  concurrencyLeases        CallConcurrencyLease[]
  consentRecords           ConsentRecord[]
  suppressionEntries       SuppressionEntry[]
  communicationPreferences CommunicationPreference[]
  campaigns                Campaign[]
  campaignRecipients       CampaignRecipient[]
  outboundAttempts         OutboundAttempt[]
  businessTrainingPacks    BusinessTrainingPack[]
  improvementObservations  ImprovementObservation[]
  improvementProposals     ImprovementProposal[]
  evaluationSuites         EvaluationSuite[]
  evaluationRuns           EvaluationRun[]
  deploymentCandidates     DeploymentCandidate[]
  agentDeployments         AgentDeployment[]
  rollbackRecords          RollbackRecord[]
  contacts                 Contact[]
  tasks                    Task[]
  handoffs                 Handoff[]
  followUps                FollowUp[]
  conversations            Conversation[]
  providerEvents           ProviderEvent[]
  backgroundJobs           BackgroundJob[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OPERATOR)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(OPERATOR)
  tokenHash   String        @unique
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("invitations")
}

model BusinessProfile {
  id                        String         @id @default(cuid())
  workspaceId               String         @unique
  businessName              String
  description               String?
  timezone                  String         @default("America/New_York")
  openingHours              Json?
  holidayRules              Json?
  defaultLanguage           String         @default("en-US")
  escalationNumberEncrypted String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  workspace                 Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations             Conversation[]
  phoneNumbers              PhoneNumber[]

  @@map("business_profiles")
}

model VoiceAgent {
  id                   String              @id @default(cuid())
  workspaceId          String
  businessProfileId    String?
  name                 String
  description          String?
  status               String              @default("ACTIVE")
  voiceProvider        ProviderType        @default(DEMO)
  voiceId              String              @default("demo-voice-maya")
  language             String              @default("en-US")
  greeting             String
  systemInstructions   String
  calendarConnectionId String?
  crmConnectionId      String?
  qualificationRuleId  String?
  escalationPolicyId   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions             AgentVersion[]
  calls                Call[]
  phoneNumbers         PhoneNumber[]
  calendarConnection   CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  crmConnection        CRMConnection?      @relation(fields: [crmConnectionId], references: [id], onDelete: SetNull)
  qualificationRule    QualificationRule?  @relation(fields: [qualificationRuleId], references: [id], onDelete: SetNull)
  escalationPolicy     EscalationPolicy?   @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  conversations        Conversation[]

  @@index([workspaceId])
  @@map("voice_agents")
}

model AgentVersion {
  id                 String         @id @default(cuid())
  agentId            String
  versionNumber      Int
  greeting           String
  systemInstructions String
  voiceId            String
  createdAt          DateTime       @default(now())
  agent              VoiceAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations      Conversation[]

  @@unique([agentId, versionNumber])
  @@map("agent_versions")
}

model PhoneNumber {
  id                    String                @id @default(cuid())
  workspaceId           String
  businessId            String?
  agentId               String?
  languageProfileId     String?
  trainingPackVersionId String?
  numberEncrypted       String?
  numberHash            String?
  numberMasked          String
  numberLast4           String?
  provider              ProviderType          @default(DEMO)
  providerId            String?
  voiceProviderPhoneNumberId String?
  status                String                @default("ACTIVE")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  business              BusinessProfile?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  agent                 VoiceAgent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  languageProfile       LanguageProfile?      @relation(fields: [languageProfileId], references: [id], onDelete: SetNull)
  trainingPackVersion   BusinessTrainingPack? @relation(fields: [trainingPackVersionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerId])
  @@unique([provider, numberHash])
  @@index([workspaceId])
  @@index([workspaceId, businessId, status])
  @@index([workspaceId, voiceProviderPhoneNumberId])
  @@map("phone_numbers")
}

model ProviderConnection {
  id                  String       @id @default(cuid())
  workspaceId         String
  providerType        ProviderType
  displayName         String
  encryptedCredential String
  status              String       @default("ACTIVE")
  lastHealthCheck     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("provider_connections")
}

model KnowledgeItem {
  id            String    @id @default(cuid())
  workspaceId   String
  title         String?
  category      String    @default("general")
  question      String
  answer        String
  content       String?
  language      String    @default("en-US")
  status        String    @default("DRAFT")
  version       Int       @default(1)
  effectiveFrom DateTime?
  expiresAt     DateTime?
  source        String?
  ownerId       String?
  verifiedAt    DateTime?
  tags          String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status, language])
  @@index([workspaceId, category])
  @@map("knowledge_items")
}

model QualificationRule {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  criteria    Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents      VoiceAgent[]

  @@index([workspaceId])
  @@map("qualification_rules")
}

model EscalationPolicy {
  id             String       @id @default(cuid())
  workspaceId    String
  name           String
  targetPhoneEnc String?
  triggers       Json
  actionType     String       @default("TRANSFER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents         VoiceAgent[]

  @@index([workspaceId])
  @@map("escalation_policies")
}

model Call {
  id                     String                @id @default(cuid())
  workspaceId            String
  agentId                String
  agentVersionId         String?
  provider               ProviderType          @default(DEMO)
  providerCallControlId  String?
  providerCallSessionId  String?
  providerCallLegId      String?
  providerConversationId String?
  direction              CallDirection         @default(INBOUND)
  channel                String                @default("PHONE") // WEB | PHONE | SIP
  language               String                @default("en-US")
  fromNumberEncrypted    String?
  toNumberEncrypted      String?
  fromNumberHash         String?
  toNumberHash           String?
  callerNumberMasked     String
  callerName             String?
  status                 CallStatus            @default(INITIATED)
  startedAt              DateTime              @default(now())
  answeredAt             DateTime?
  endedAt                DateTime?
  durationSeconds        Int                   @default(0)
  terminationReason      String?
  recordingConsent       Boolean               @default(false)
  recordingConsentState  RecordingConsentState @default(NOT_REQUESTED)
  outcome                CallOutcome?
  qualificationCategory  LeadCategory?
  qualificationScore     Float?
  appointmentId          String?               @unique
  leadId                 String?               @unique
  contactId              String?
  campaignId             String?
  escalationUsed         Boolean               @default(false)
  estimatedCost          Float                 @default(0.0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent                  VoiceAgent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events                 CallEvent[]
  transcriptSegments     TranscriptSegment[]
  summary                CallSummary?
  legs                   CallLeg[]
  participants           CallParticipant[]
  recordings             CallRecording[]
  toolExecutions         CallToolExecution[]
  evaluations            CallEvaluation[]
  appointment            Appointment?          @relation("CallToAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  lead                   Lead?                 @relation("CallToLead", fields: [leadId], references: [id], onDelete: SetNull)
  conversation           Conversation?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("calls")
}

model CallLeg {
  id              String    @id @default(cuid())
  callId          String
  legType         String // INBOUND | OUTBOUND | AGENT | HUMAN
  providerLegId   String?
  direction       String
  fromNumber      String?
  toNumber        String?
  status          String    @default("INITIATED")
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  sipHeaders      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  call            Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_legs")
}

model CallParticipant {
  id              String    @id @default(cuid())
  callId          String
  participantType String // CALLER | AGENT | HUMAN | SYSTEM
  identifier      String?
  name            String?
  role            String?
  joinedAt        DateTime?
  leftAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  call            Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_participants")
}

model CallToolExecution {
  id           String   @id @default(cuid())
  callId       String
  toolName     String
  parameters   Json?
  result       Json?
  success      Boolean  @default(false)
  errorMessage String?
  executedAt   DateTime @default(now())
  durationMs   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  call         Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_tool_executions")
}

model CallRecording {
  id              String    @id @default(cuid())
  callId          String
  recordingUrl    String?
  recordingPath   String?
  durationSeconds Int       @default(0)
  fileSizeBytes   Int?
  format          String    @default("mp3")
  retentionPolicy String?
  accessUrl       String?
  accessExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  call            Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_recordings")
}

model CallEvaluation {
  id               String   @id @default(cuid())
  callId           String
  evaluatorType    String // DETERMINISTIC | MODEL_BASED
  evaluatorVersion String
  rubricVersion    String?
  category         String
  score            Float?
  evidence         Json?
  confidence       Float?
  evaluatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  call             Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_evaluations")
}

model CallEvent {
  id               String    @id @default(cuid())
  callId           String
  eventType        String
  sequence         Int
  providerEventId  String? // Telnyx event ID for deduplication
  occurredAt       DateTime  @default(now())
  eventTime        DateTime?
  normalizedType   String?
  safePayload      Json
  processedAt      DateTime?
  processingStatus String    @default("PENDING") // PENDING | PROCESSED | FAILED | DEAD_LETTER
  retryCount       Int       @default(0)
  correlationId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  call             Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([providerEventId])
  @@index([processingStatus])
  @@map("call_events")
}

model TranscriptSegment {
  id         String   @id @default(cuid())
  callId     String
  speaker    String // "agent" | "caller" | "system"
  text       String
  startMs    Int
  endMs      Int
  confidence Float    @default(1.0)
  redacted   Boolean  @default(false)
  createdAt  DateTime @default(now())
  call       Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("transcript_segments")
}

model CallSummary {
  id                     String   @id @default(cuid())
  callId                 String   @unique
  summary                String
  intent                 String
  sentiment              String   @default("neutral") // positive | neutral | negative
  urgency                String   @default("medium") // low | medium | high | critical
  actionItems            Json
  commitments            Json
  followUpRecommendation String?
  createdAt              DateTime @default(now())
  call                   Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_summaries")
}

model Lead {
  id              String       @id @default(cuid())
  workspaceId     String
  callId          String?      @unique
  name            String
  phoneEncrypted  String?
  emailEncrypted  String?
  company         String?
  serviceInterest String?
  budgetRange     String?
  timeline        String?
  authority       String?
  urgency         String?
  score           Float        @default(0)
  category        LeadCategory @default(WARM)
  status          String       @default("NEW")
  assignedTo      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  call            Call?        @relation("CallToLead")

  @@index([workspaceId])
  @@index([workspaceId, category])
  @@map("leads")
}

model Opportunity {
  id                    String           @id @default(cuid())
  workspaceId           String
  contactId             String
  sourceConversationId  String?          @unique
  title                 String
  serviceInterest       String?
  stage                 OpportunityStage @default(QUALIFIED)
  qualificationCriteria Json
  evidence              Json
  confidence            Float?
  recommendation        String?
  ownerId               String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact               Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sourceConversation    Conversation?    @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, stage, updatedAt])
  @@index([workspaceId, contactId, updatedAt])
  @@index([ownerId, stage])
  @@map("opportunities")
}

model CalendarConnection {
  id                  String        @id @default(cuid())
  workspaceId         String
  provider            ProviderType  @default(DEMO)
  displayName         String
  encryptedCredential String?
  status              String        @default("ACTIVE")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents              VoiceAgent[]
  appointments        Appointment[]

  @@index([workspaceId])
  @@map("calendar_connections")
}

model Appointment {
  id                     String              @id @default(cuid())
  workspaceId            String
  contactId              String?
  conversationId         String?
  callId                 String?             @unique
  calendarConnectionId   String?
  externalEventId        String?
  callerName             String
  callerContactEncrypted String?
  service                String
  startTime              DateTime
  endTime                DateTime
  timezone               String              @default("America/New_York")
  status                 AppointmentStatus   @default(CONFIRMED)
  confirmationStatus     String              @default("CONFIRMED")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact                Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation           Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  calendarConnection     CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  call                   Call?               @relation("CallToAppointment")

  @@index([workspaceId])
  @@index([workspaceId, startTime])
  @@index([workspaceId, contactId, startTime])
  @@index([conversationId])
  @@map("appointments")
}

model CRMConnection {
  id                  String        @id @default(cuid())
  workspaceId         String
  provider            ProviderType  @default(DEMO)
  displayName         String
  encryptedCredential String?
  status              String        @default("ACTIVE")
