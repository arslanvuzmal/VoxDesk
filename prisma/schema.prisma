  reason            String
  destination       String
  attemptCount      Int       @default(0)
  transferStartedAt DateTime?
  transferEndedAt   DateTime?
  result            String?
  finalOwner        String?
  briefText         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("handoffs")
}

model FollowUp {
  id               String    @id @default(cuid())
  workspaceId      String
  callId           String?
  contactId        String?
  campaignId       String?
  followUpType     String // CALLBACK | APPOINTMENT_CONFIRMATION | MISSING_INFORMATION | SURVEY
  preferredTime    DateTime?
  preferredChannel String    @default("PHONE")
  status           String    @default("PENDING")
  assignedTo       String?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("follow_ups")
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  metadata     Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}
