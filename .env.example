# VoxDesk environment reference
# Copy to .env.local. Never commit a populated environment file.

# Application
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# Required for persisted conversations, CRM state, and simulation.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Telephony mode
# simulation is safe for the public portfolio and never dials PSTN.
# live requires every live-only Telnyx/ElevenLabs resource and fails closed.
TELEPHONY_MODE="simulation"

# Security (supply strong unique values in production secret storage)
# AUTH_SECRET=""
# ENCRYPTION_KEY=""
# INTERNAL_API_SECRET=""
# DEMO_SESSION_SECRET=""
# IP_HASH_SECRET=""
# PHONE_HASH_SECRET=""

# ElevenLabs (web voice / live SIP activation)
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET=""

# Telnyx (live-only PSTN/SIP activation)
TELNYX_API_KEY=""
TELNYX_PUBLIC_KEY=""
TELNYX_CONNECTION_ID=""
TELNYX_PRIMARY_PHONE_NUMBER=""
TELNYX_OUTBOUND_VOICE_PROFILE_ID=""
TELNYX_WEBHOOK_SECRET=""
TELNYX_SIP_USERNAME=""
TELNYX_SIP_PASSWORD=""
TELNYX_SIP_TRUNK_ID=""
TELNYX_TELEPHONY_ENABLED="false"
TELNYX_INBOUND_ENABLED="false"
TELNYX_OUTBOUND_ENABLED="false"
OUTBOUND_CAMPAIGNS_ENABLED="false"

# Redis-compatible leases and quotas (recommended for distributed production controls)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Demo and operational limits
DEMO_ENABLED="true"
DEMO_MODE="true"
DEMO_LIVE_PROVIDER_KILL_SWITCH="false"
DEMO_MAX_DURATION_SECONDS="180"
DEMO_MAX_TURNS="6"
CONTENT_LOGGING_MODE="metadata_only"

# Feature controls
CALL_RECORDING_ENABLED="false"
SUPERVISED_IMPROVEMENT_ENABLED="false"
MULTILINGUAL_TELEPHONY_ENABLED="false"
CONVERSATION_DUAL_WRITE_ENABLED="false"
ALLOW_PRODUCTION_SEED="false"

# Legacy compatibility settings are intentionally omitted. They are not part of
# the canonical Telnyx + ElevenLabs deployment path; see docs/audits/.
