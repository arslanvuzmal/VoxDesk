# VoxDesk portfolio-demo configuration
#
# DATABASE_URL is required. Everything else only enables the matching channel.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Website voice and conversation finalization
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET=""

# Telephone calling. Configure only when Telnyx is connected.
TELNYX_API_KEY=""
TELNYX_CONNECTION_ID=""
TELNYX_PRIMARY_PHONE_NUMBER=""
TELNYX_OUTBOUND_VOICE_PROFILE_ID=""
TELNYX_WEBHOOK_SECRET=""

# Explicitly enable a configured telephone capability.
TELNYX_TELEPHONY_ENABLED="false"
TELNYX_INBOUND_ENABLED="false"
TELNYX_OUTBOUND_ENABLED="false"
OUTBOUND_CAMPAIGNS_ENABLED="false"

# Public deployment URL, used for provider webhook callbacks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
